{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "StopC",
  "version": "1.0.2",
  "identifier": "com.stopc.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "StopC",
        "url": "index.html",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "decorations": true,
        "visible": true,
        "center": true
      },
      {
        "label": "notification",
        "title": "StopC Notification",
        "url": "notification.html",
        "width": 380,
        "height": 260,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "appimage", "deb", "rpm"],
    "publisher": "Thinakaran Manokaran",
    "copyright": "Copyright © 2026 Thinakaran Manokaran. All rights reserved.",
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      },
      "wix": {
        "template": "main.wxs"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
